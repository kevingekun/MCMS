SELECT
  cms_content.id AS "id",
  content_title AS "title",
  content_short_title AS "shorttitle",
  content_author AS "author",
  content_source AS "source",
  content_out_link AS "outlink",
  content_tags AS "tags",

  category.category_title AS "typetitle",
  category.category_short_title AS "typeshorttitle",
  category.id AS "typeid",
  category.category_path AS "typepath",
  category.category_img AS "typelitpic",
  category.category_ico AS "typeico",
  category.category_keyword as "typekeyword",
  category.top_id as "topid",
  category.category_id as "parentid",
  category.category_parent_ids as "parentids",
  category.category_type AS "type",
      CONCAT(category.category_path,'/index.html') AS "typelink",
  content_description AS "descrip",
  content_hit AS "hit",
  content_type AS "flag",
  cms_content.content_keyword AS "keyword",
  content_img AS "litpic",
        CONCAT(CONCAT( category.category_path, '/' ), CONCAT(CASE category_type WHEN  '2' THEN 'index' ELSE cms_content.id END , '.html' )) as "link",
  
  content_datetime AS "date"
FROM
  cms_content
LEFT JOIN
  cms_category as category
ON cms_content.category_id = category.id
WHERE
  content_display='0'
  and category_display='enable'
  and cms_content.del=0

        and (cms_content.category_id='1666653706550321162'
        or cms_content.category_id in (select id FROM cms_category where cms_category.del=0
        and FIND_IN_SET('1666653706550321162',CATEGORY_PARENT_IDS) > 0))









    ORDER BY
      cms_content.content_datetime desc
  LIMIT
    20

