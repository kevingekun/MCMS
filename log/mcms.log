select
    cms_category.id as "id",
    cms_category.id as "typeid",
    cms_category.category_title as "typetitle",
    cms_category.category_short_title as "typeshorttitle",
            CONCAT(cms_category.category_path,'/index.html') as "typelink",
    cms_category.category_keyword as "typekeyword",
    cms_category.category_diy_url as "typeurl",
    cms_category.category_flag as "flag",
    cms_category.category_id as "parentid",
    cms_category.category_parent_ids as "parentids",
    cms_category.category_descrip as "typedescrip",
    cms_category.category_type as "type",
    cms_category.category_path as "typepath",
    cms_category.leaf as "typeleaf",
    cms_category.category_img as "typelitpic" ,
    cms_category.category_ico as "typeico" ,
    
    ( SELECT count(*) FROM cms_category cc WHERE cc.category_id = cms_category.id AND cc.del = 0 ) AS "childsize"
from
    cms_category

where
    cms_category.del=0
    and  cms_category.category_display = 'enable'
    and  cms_category.is_child = 'cms'

    and
    (
    
    FIND_IN_SET('n',cms_category.category_flag)>0
    )



    and(cms_category.category_id is null)


    
    ORDER BY
             cms_category.category_sort
            
LIMIT
9999
